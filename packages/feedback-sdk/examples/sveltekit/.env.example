# Vite reads variables prefixed with VITE_* and exposes them to the browser.
# Copy this file to `.env` (or `.env.local`) and fill in your values.

# Where the API runs. Default for local dev: http://localhost:8787
VITE_FEEDBACK_API_URL=http://localhost:8787

# Per-project API key issued by the dashboard at:
#   /projects/<slug>/keys
#
# Leave empty to fall back to the in-memory mock transport (no network calls,
# data stays in the browser tab).
VITE_FEEDBACK_API_KEY=
