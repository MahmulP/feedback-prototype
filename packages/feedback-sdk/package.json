{
  "name": "@mahmulp/feedback-sdk",
  "version": "0.0.1",
  "description": "Framework-agnostic visual feedback SDK for prototypes. Pin comments to UI elements, with stable DOM selectors plus screenshot capture. Svelte primary; works in React, Vue, and plain HTML.",
  "license": "MIT",
  "author": {
    "name": "Mahmul Pratama",
    "url": "https://github.com/MahmulP"
  },
  "homepage": "https://github.com/MahmulP/feedback-prototype/tree/main/packages/feedback-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmulP/feedback-prototype.git",
    "directory": "packages/feedback-sdk"
  },
  "bugs": {
    "url": "https://github.com/MahmulP/feedback-prototype/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte.js",
      "import": "./dist/svelte.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "require": "./dist/mock.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "echo 'no lint configured for feedback-sdk yet'",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0",
    "html2canvas": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "happy-dom": "^15.11.0",
    "html2canvas": "^1.4.1",
    "svelte": "^5.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "feedback",
    "annotation",
    "comments",
    "prototype",
    "design-review",
    "qa",
    "svelte",
    "self-hosted",
    "screenshot"
  ],
  "publishConfig": {
    "access": "public"
  }
}
