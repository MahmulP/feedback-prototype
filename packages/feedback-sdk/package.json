{
  "name": "@mahmulp/feedback-sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic visual feedback SDK for prototypes. Svelte primary, works in React, Vue, and plain HTML.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte.js",
      "import": "./dist/svelte.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "require": "./dist/mock.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "echo 'no lint configured for feedback-sdk yet'"
  },
  "dependencies": {
    "@mahmulp/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0",
    "html2canvas": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "happy-dom": "^15.11.0",
    "html2canvas": "^1.4.1",
    "svelte": "^5.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "feedback",
    "annotation",
    "prototype",
    "svelte",
    "self-hosted"
  ]
}
