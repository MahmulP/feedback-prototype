{
  "name": "feedback-prototype",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/feedback-sdk/examples/*"
  ],
  "scripts": {
    "dev:dashboard": "bun --filter ./apps/dashboard dev",
    "dev:api": "bun --filter @mahmulp/api dev",
    "build:sdk": "bun --filter @mahmulp/feedback-sdk build",
    "test:sdk": "bun --filter @mahmulp/feedback-sdk test",
    "test:api": "bun --filter @mahmulp/api test",
    "smoke": "bun run scripts/e2e-smoke.ts",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
