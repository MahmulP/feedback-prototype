# Port the API listens on. Default: 8787.
PORT=8787

# Local filesystem path for screenshot storage. Default: ./data/screenshots
STORAGE_DIR=./data/screenshots

# Comma-separated list of origins allowed to call the API (SDK ingest + dashboard).
# Use "*" only for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL connection string. When unset, the API uses an in-memory store
# (data is lost on restart). Set this for any deployment that needs to
# survive a process restart.
# DATABASE_URL=postgres://user:pass@localhost:5432/feedback

# HMAC secret for the dashboard cookie session.
# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Permits per minute on SDK ingest endpoints, per project key.
RATE_LIMIT_INGEST_PER_MIN=60

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ----- Email notifications (SMTP) -----
# Email is sent to a project's owner whenever new feedback or a reply arrives.
# Notifications are OFF unless both SMTP_HOST and SMTP_FROM are set.

# SMTP server hostname, e.g. smtp.gmail.com / smtp.resend.com / smtp.mailgun.org
SMTP_HOST=

# SMTP port. 587 = STARTTLS (default), 465 = implicit TLS.
SMTP_PORT=587

# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS).
SMTP_SECURE=false

# SMTP auth credentials. Leave empty for unauthenticated relays.
SMTP_USER=
SMTP_PASS=

# From header on outgoing mail. e.g. "Feedback <noreply@iwkapps.com>"
SMTP_FROM=

# Public dashboard base URL, used to build "view in dashboard" links in emails.
# e.g. https://prototype.mahmulp.dev
DASHBOARD_URL=

# Coalescing window (seconds). Activity for a project within this window is
# batched into ONE digest email instead of one email per comment. This is the
# main defense against form-spam burning through an SMTP daily quota.
# A burst of 30 comments in 2 minutes becomes a single email. Set 0 to disable.
EMAIL_DIGEST_WINDOW_SEC=120

# Hard cap on notification emails per project per rolling hour (backstop).
# Set 0 to disable the cap.
EMAIL_MAX_PER_HOUR=20
