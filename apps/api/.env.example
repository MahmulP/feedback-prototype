# Port the API listens on. Default: 8787.
PORT=8787

# Local filesystem path for screenshot storage. Default: ./data/screenshots
STORAGE_DIR=./data/screenshots

# Comma-separated list of origins allowed to call the API (SDK ingest + dashboard).
# Use "*" only for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL connection string. When unset the API uses an in-memory store
# (data is lost on restart). Set this for any deployment that needs to survive
# a process restart.
# DATABASE_URL=postgres://user:pass@localhost:5432/feedback

# ----- Auth -----
# When BOTH ADMIN_API_KEY and PROJECT_API_KEYS are unset, the API runs OPEN
# (no auth). That's local-dev mode. Setting either one enables auth on every
# protected route.

# Master key the dashboard uses for privileged calls (read all feedback,
# transition status, etc). Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Per-project SDK keys. Comma-separated `projectId:key` pairs. Each prototype
# uses its own key so a leaked key only exposes one project.
# Example:
# PROJECT_API_KEYS=prototype-a:abc123...,prototype-b:def456...
PROJECT_API_KEYS=

# ----- Limits & logging -----
# Permits per minute on SDK ingest endpoints, per key.
RATE_LIMIT_INGEST_PER_MIN=60

# Logging level: debug | info | warn | error
LOG_LEVEL=info
