# ----- Server-only -----

# Internal API URL used by the Next.js server (Server Components, Route Handlers).
# Default for local dev: http://localhost:8787
FEEDBACK_API_URL=http://localhost:8787

# Service-to-service key for privileged calls (admin endpoints).
# Generate with: openssl rand -hex 32
DASHBOARD_API_KEY=

# Cookie session signing secret (required in production). 32+ random bytes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# ----- Browser-exposed (NEXT_PUBLIC_*) -----

# Public-facing API URL used by the browser. Often equal to FEEDBACK_API_URL,
# but can differ when the dashboard is behind a proxy.
NEXT_PUBLIC_FEEDBACK_API_URL=http://localhost:8787

# Display name shown in chrome / page title.
NEXT_PUBLIC_APP_NAME=Feedback

# ----- Auth (single-admin v1) -----

# Admin email allowed to sign in. When unset, auth is disabled and every page
# is public — convenient for local dev; never deploy that way.
ADMIN_EMAIL=

# Plain password OR pre-hashed (sha256 hex). If both are set, the hash wins.
# For any non-local environment use ADMIN_PASSWORD_HASH and rotate by updating it.
# Compute a hash with: echo -n "your-password" | sha256sum
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
