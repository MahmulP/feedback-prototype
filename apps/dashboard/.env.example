# ----- Server-only -----

# Internal API URL used by the Next.js server (Server Components, Route Handlers).
# Default for local dev: http://localhost:8787
FEEDBACK_API_URL=http://localhost:8787

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# ----- Browser-exposed (NEXT_PUBLIC_*) -----

# Public-facing API URL used by the browser. Often equal to FEEDBACK_API_URL,
# but can differ when the dashboard is behind a proxy.
NEXT_PUBLIC_FEEDBACK_API_URL=http://localhost:8787

# Display name shown in chrome / page title.
NEXT_PUBLIC_APP_NAME=Feedback
